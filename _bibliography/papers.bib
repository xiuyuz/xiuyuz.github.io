@article{lmsm,
  preview={lmsm-figure1.svg},
  abbr={Preprint},
  title={LMSM: LLM Security Framework Inspired by Linux Security Modules},
  author={Zhang, XiuYu and Ruan, Bonan and Fang, Junfeng and Zhang, An and Chua, Tat-Seng and Liang, Zhenkai},
  journal={arXiv preprint},
  year={2026},
  arxiv={2608.25697},
  doi={10.48550/arXiv.2608.25697},
  pdf={https://arxiv.org/pdf/2608.25697},
  abstract={Summary: LMSM brings a modular security architecture to language-model serving. It separates model-internal evidence, policy decisions, and permission to release generated output, allowing different monitoring methods to share the same enforcement infrastructure. Experiments with Transformers and vLLM show that this separation supports multiple policies and concurrent requests. On Qwen3-4B, the prototype substantially reduces successful harmful prompts while retaining most of the throughput of an unmonitored serving configuration.},
  selected={true},
}

