  author={Matuck, Bruno F. and Huynh, Khoa L. A. and Pereira, Diana and Easter, Quinn T. and Zhang, XiuYu and Kunz, Meik and Kumar, Nikhil and Pratapa, Aditya and Rupp, Brittany T. and Ghodke, Ameer and Predeus, Alexander V. and Fernandes, Alexandre and Szabó, Lili and Hartmann, Stefan and Harnischfeger, Nadja and Khavandgar, Zohreh and Beach, Margaret and Perez, Paola and Nilges, Benedikt and Moreno, Maria M. and Ko, Kang I. and Singh, Rohit and Tata, Purushothama Rao and Teichmann, Sarah A. and Kimple, Adam and Pringle, Sarah and Kretzschmar, Kai and Warner, Blake M. and Sequeira, Inês and Liu, Jinze and Byrd, Kevin M.},
  journal={Cell Press Blue},
  year={2026},
  volume={1},
  number={1},
  pages={100007},
  doi={10.1016/j.cpblue.2026.100007},
  html={https://doi.org/10.1016/j.cpblue.2026.100007},
  abstract={Summary: This study combines single-cell RNA sequencing with spatial protein and RNA measurements to map immune organization across adult oral tissues. The atlas identifies fibroblast populations and neighborhoods associated with immune signaling, using AstroSuite to connect cell identities, locations, and predicted interactions. Comparing healthy tissue with chronic periodontitis reveals changes in fibroblast states and their surrounding immune environments. The resulting resource provides a framework for investigating stromal contributions to oral inflammation and identifying candidate therapeutic pathways.},
  selected={true},
}

