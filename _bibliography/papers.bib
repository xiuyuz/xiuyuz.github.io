@article{starcomm,
  abbr={Preprint},
  title={STARComm Scalably Detects Emergent Modules of Spatial Cell-Cell Communication in Inflammation and Cancer},
  author={Huynh, Khoa L. A. and Matuck, Bruno F. and de Souza, Deiziane and Zhang, XiuYu and Fatobene, Giancarlo and Soares Junior, Luiz Alberto Valente and Ferraz da Silva, Luiz Fernando and Rocha, Vanderson Geraldo and Byrd, Kevin M. and Liu, Jinze},
  journal={bioRxiv preprint},
  year={2025},
  doi={10.1101/2025.08.07.669133},
  html={https://www.biorxiv.org/content/10.1101/2025.08.07.669133v1},
  abstract={Summary: STARComm identifies spatial patterns of intercellular signaling from two- and three-dimensional transcriptomic data by grouping co-located ligand-receptor activity into multicellular communication modules. Analysis of more than 14 million cells across eight cancers uncovered shared and tumor-specific signaling programs. In salivary gland samples from chronic graft-versus-host disease, communication modules were associated with survival and highlighted candidate therapeutic pathways, illustrating the potential of spatial communication analysis for biomarker discovery and disease profiling.},
  selected={true},
}

