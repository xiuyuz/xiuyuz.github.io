@inproceedings{see,
  preview={see.png},
  code={https://github.com/YiShan05/SEE_official},
  abbr={EMNLP Findings},
  title={Self-Evaluation Is Already There: Eliciting Latent Judge Calibration in Base LLMs with Minimal Data},
  author={Zhang, XiuYu and Shan, Yi and Fang, Junfeng and Liang, Zhenkai},
  booktitle={Findings of the Association for Computational Linguistics: EMNLP 2026},
  year={2026},
  arxiv={2606.05122},
  doi={10.48550/arXiv.2606.05122},
