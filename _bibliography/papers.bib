  annotation={Equal contribution: XiuYu Zhang and Yi Shan. Corresponding author: Junfeng Fang.},
  abstract={Summary: This work studies whether language models can anticipate the quality scores assigned to their own answers by external model judges. Self-Evaluation Elicitation alternates reinforcement learning with masked distillation to improve this calibration using 160 examples. Experiments across three benchmarks find that base models already possess useful self-evaluation ability, and that the proposed training can expose it while maintaining response quality and transferring to judges outside the training setup.},
  selected={true},
}

