@article{cosine_misleads,
  preview={cosine_misleads-figure1.svg},
  abbr={Preprint},
  title={Cosine Misleads: Auxiliary Losses Reshape Vision Language Models, Not Their Latents},
  author={Zhang, XiuYu and Fang, Junfeng and Liang, Zhenkai},
  journal={arXiv preprint},
  year={2026},
  arxiv={2606.05753},
  doi={10.48550/arXiv.2606.05753},
  pdf={https://arxiv.org/pdf/2606.05753},
  abstract={Summary: This study tests whether aligning supervised latent tokens with visual targets improves reasoning in vision-language models. Across five variants, stronger cosine alignment instead accompanies lower answer accuracy. PRISM combines linear probing with latent corruption to examine where answer information appears and whether generation depends on the latent tokens. The results suggest that auxiliary supervision primarily changes shared language-model parameters, while the supervised latents themselves contribute relatively little to the final answer.},
  selected={true},
}

